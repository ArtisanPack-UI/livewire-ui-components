# Ignore all test and documentation with "export-ignore".

# Git and IDE files
/.gitattributes export-ignore
/.gitignore export-ignore
/.gitlab export-ignore
/.gitlab-ci.yml export-ignore
/.idea export-ignore
/.junie export-ignore
/.claude export-ignore
/.coderabbit.yaml export-ignore
/.ai export-ignore
/.DS_Store export-ignore

# Release planning documents
/LIVEWIRE-UI-1.0-PLAN.md export-ignore

# Lock file (not needed for package releases)
/composer.lock export-ignore

# Testing and code quality
/tests export-ignore
/src/**/Tests export-ignore
/src/**/*Test.php export-ignore
/src/**/Test.php export-ignore
/phpunit.xml export-ignore
/phpunit.xml.dist export-ignore
/phpcs.xml export-ignore
/phpstan.neon.dist export-ignore
/infection.json.dist export-ignore
/.phpunit.cache export-ignore
/.phpunit.result.cache export-ignore

# Coverage reports
/coverage export-ignore
/coverage-report export-ignore

# Development files
/debug-generator.php export-ignore
/generate-tests.php export-ignore
/test-button-render.php export-ignore

# Documentation
/docs export-ignore
/CONTRIBUTING.md export-ignore
/CHANGELOG.md export-ignore

# Pint
/pint.json export-ignore
/pint-setup.php export-ignore
