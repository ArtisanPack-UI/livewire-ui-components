{
    "name": "artisanpack-ui/livewire-ui-components",
    "description": "A Livewire UI component library for the TALL stack, forked from MaryUI and adapted for the ArtisanPack UI ecosystem.",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Jacob Martella",
            "email": "me@jacobmartella.com"
        }
    ],
    "keywords": [
        "laravel",
        "livewire",
        "livewire 3",
        "livewire ui",
        "livewire ui components",
        "tallstack",
        "tallstack ui",
        "tallstackui",
        "tallstack components",
        "blade",
        "ui",
        "blade ui components",
        "livewire-components",
        "livewire components",
        "livewire-packages",
        "livewire packages",
        "tailwind",
        "components",
        "daisyUI",
        "alpinejs"
    ],
    "require": {
        "illuminate/support": "^10.0|^11.0|^12.0",
        "jfcherng/php-diff": "^6.15",
        "laravel/prompts": "^0|^1",
        "blade-ui-kit/blade-heroicons": "^2.0",
        "livewire/livewire": "^3.6",
        "artisanpack-ui/accessibility": "^2.0.0",
        "artisanpack-ui/security": "^1.0",
        "owenvoke/blade-fontawesome": "^2.9",
        "artisanpack-ui/core": "^1.0",
        "artisanpack-ui/icons": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8|^9|^10",
        "pestphp/pest": "^3.5",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-type-coverage": "^3.0",
        "pestphp/pest-plugin-watch": "^3.0",
        "phpunit/phpunit": "^10|^11",
        "mockery/mockery": "^1.6",
        "laravel/boost": "^1.0",
        "laravel/dusk": "^8.0",
        "squizlabs/php_codesniffer": "^3.13",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "artisanpack-ui/code-style": "^1.0",
        "spatie/pest-plugin-snapshots": "^2.0",
        "nunomaduro/collision": "^8.0",
        "fakerphp/faker": "^1.20",
        "livewire/volt": "^1.0",
        "ext-dom": "*",
        "ext-libxml": "*",
        "brianium/paratest": "^7.0",
        "phpstan/phpstan": "^2.0",
        "larastan/larastan": "^3.0",
        "rector/rector": "^2.0",
        "infection/infection": "^0.29",
        "laravel/pint": "^1.25",
        "artisanpack-ui/code-style-pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "ArtisanPack\\LivewireUiComponents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ArtisanPack\\LivewireUiComponents\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ArtisanPack\\LivewireUiComponents\\LivewireUiComponentsServiceProvider"
            ],
            "aliases": {
                "LivewireUiComponents": "ArtisanPack\\LivewireUiComponents\\Facades\\LivewireUiComponents"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test local coverage": "herd coverage ./vendor/bin/pest --coverage-html coverage-report"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        }
    }
}
