{
    "name": "artisanpack-ui/livewire-ui-components",
    "description": "A Livewire UI component library for the TALL stack, forked from MaryUI and adapted for the ArtisanPack UI ecosystem.",
    "license": "MIT",
    "version": "0.4.4",
    "authors": [
        {
            "name": "Jacob Martella",
            "email": "me@jacobmartella.com"
        }
    ],
    "keywords": [
        "laravel",
        "livewire",
        "livewire 3",
        "livewire ui",
        "livewire ui components",
        "tallstack",
        "tallstack ui",
        "tallstackui",
        "tallstack components",
        "blade",
        "ui",
        "blade ui components",
        "livewire-components",
        "livewire components",
        "livewire-packages",
        "livewire packages",
        "tailwind",
        "components",
        "daisyUI",
        "alpinejs"
    ],
    "require": {
        "illuminate/support": "^10.0|^11.0|^12.0",
        "jfcherng/php-diff": "^6.15",
        "laravel/prompts": "^0|^1",
        "blade-ui-kit/blade-heroicons": "^2.0",
        "livewire/livewire": "^3.6",
        "artisanpack-ui/accessibility": "^1.1",
        "artisanpack-ui/security": "^1.0",
        "owenvoke/blade-fontawesome": "^2.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10|^11",
        "orchestra/testbench": "^8|^9|^10"
    },
    "autoload": {
        "psr-4": {
            "ArtisanPack\\LivewireUiComponents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ArtisanPack\\LivewireUiComponents\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ArtisanPack\\LivewireUiComponents\\LivewireUiComponentsServiceProvider"
            ],
            "aliases": {
                "LivewireUiComponents": "ArtisanPack\\LivewireUiComponents\\Facades\\LivewireUiComponents"
            }
        }
    }
}
