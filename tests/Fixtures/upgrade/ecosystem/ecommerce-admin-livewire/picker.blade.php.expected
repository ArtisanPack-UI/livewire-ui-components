@if ( ! $available() )
    <x-artisanpack-alert
        color="info"
        icon="o-information-circle"
        :title="$label"
        :description="$unavailableMessage()"
        role="status"
    />
@elseif ( $live )
    <x-artisanpack-combobox
        :id="$id ?? $model"
        :label="$label"
        :hint="$hint"
        :options="$options"
        :multiple="! ($single)"
        remote
        :search-function="$searchFunction()"
        option-value="id"
        option-label="name"
        option-sub-label="description"
        :debounce="300"
        :empty-label="__( 'No results found.' )"
        wire:model.live="{{ $model }}"
        {{ $attributes->whereDoesntStartWith( 'wire:model' ) }}
    />
@else
    <x-artisanpack-combobox
        :id="$id ?? $model"
        :label="$label"
        :hint="$hint"
        :options="$options"
        :multiple="! ($single)"
        remote
        :search-function="$searchFunction()"
        option-value="id"
        option-label="name"
        option-sub-label="description"
        :debounce="300"
        :empty-label="__( 'No results found.' )"
        wire:model="{{ $model }}"
        {{ $attributes->whereDoesntStartWith( 'wire:model' ) }}
    />
@endif
